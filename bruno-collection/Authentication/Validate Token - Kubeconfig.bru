meta {
  name: Validate Token - Kubeconfig
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/validate-token
  body: json
  auth: none
}

body:json {
  {
    "type": "kubernetes",
    "kube": {
      "kubeconfig_content": "PASTE_YOUR_KUBECONFIG_YAML_HERE",
      "context": ""
    }
  }
}

docs {
  Validate Kubernetes credentials by testing cluster connectivity.
  
  Body fields:
  - type: "kubernetes"
  - kube.kubeconfig_content: full kubeconfig YAML content (as a string)
  - kube.context: optional kubectl context name (empty = use default context)
  
  The server will attempt to connect to the cluster and verify access.
  Returns validation result with cluster info on success.
  
  TIP: Paste the raw content of your ~/.kube/config file into kubeconfig_content.
}
