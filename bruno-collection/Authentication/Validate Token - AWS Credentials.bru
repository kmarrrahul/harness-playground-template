meta {
  name: Validate Token - AWS Credentials
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/validate-token
  body: json
  auth: none
}

body:json {
  {
    "type": "aws",
    "aws": {
      "auth_method": "env_vars",
      "access_key": "YOUR_AWS_ACCESS_KEY",
      "secret_key": "YOUR_AWS_SECRET_KEY",
      "region": "us-east-1"
    }
  }
}

docs {
  Validate AWS credentials by calling AWS STS GetCallerIdentity.
  
  Body fields:
  - type: "aws"
  - aws.auth_method: "env_vars" | "role_arn" | "creds_file"
  - aws.access_key: AWS access key ID
  - aws.secret_key: AWS secret access key
  - aws.region: AWS region (e.g. "us-east-1")
  
  Optional AWS fields:
  - aws.role_arn: for assume-role authentication
  - aws.session_token: for temporary credentials
  - aws.creds_file_content: raw credentials file content
  
  Returns validation result with AWS account/ARN info on success.
}
